rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Libros y manuales públicos o para usuarios autenticados
    match /libros/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Material de tests y protocolos clínicos
    match /tests/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Archivos y adjuntos de historias clínicas privadas
    match /clinicians/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
